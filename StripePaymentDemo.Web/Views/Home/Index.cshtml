@model IReadOnlyList<StripePaymentDemo.Domain.Entities.Product>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <h1>Stripe Payment Demo</h1>
    
    <p class="lead">
        Select a test product below to try the Stripe Checkout flow.
    </p>
    
    @if(@Model.Count ==0)
    {
        <p>No products are currently available.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            @product.Name
                        </h5>
                        <h4 class="mb-4">
                            @product.Price.ToString("C",
                                System.Globalization.CultureInfo
                                    .GetCultureInfo("en-GB"))
                        </h4>
                        
                        <div class="mt-auto">
                            <a asp-controller="checkout"
                               asp-action="Index"
                               asp-route-productId="@product.Id"
                               class="btn btn-primary w-100">
                                Buy
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>